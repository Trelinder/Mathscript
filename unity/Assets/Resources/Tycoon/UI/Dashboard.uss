.perspective { --hud-ink: #293238; --hud-muted: #526269; --hud-paper: #f4f7f8; --hud-line: #becbd0; --hud-teal: #147d80; --hud-gold: #e7bc54; }
.perspective .header { height: 68px; padding-left: 54px; padding-right: 14px; background-color: var(--hud-paper); border-bottom-width: 1px; border-bottom-color: var(--hud-line); }
.perspective .brand-lockup { width: 202px; flex-shrink: 0; }
.perspective .brand { width: auto; font-size: 23px; color: var(--hud-ink); white-space: nowrap; }
.perspective .brand-subtitle { font-size: 13px; color: var(--hud-muted); margin-top: 1px; }
.perspective .header-money { min-width: 164px; }
.perspective .cash-title { font-size: 12px; color: var(--hud-muted); height: 15px; }
.perspective .currency { width: 164px; min-width: 164px; max-width: 164px; color: var(--hud-ink); font-size: 28px; height: 30px; -unity-font-style: bold; -unity-text-align: middle-center; }
.perspective .header-income { width: 164px; min-width: 164px; max-width: 164px; color: #17634e; font-size: 13px; height: 17px; white-space: nowrap; -unity-text-align: middle-center; }
.perspective .header-resources { width: 282px; flex-shrink: 0; }
.perspective .chip { width: 84px; height: 42px; padding: 0 8px; margin-left: 4px; background-color: transparent; border-width: 0; border-left-width: 1px; border-left-color: var(--hud-line); border-radius: 0; }
.perspective .chip Label { color: var(--hud-ink); font-size: 20px; -unity-font-style: bold; }
.perspective .chip .muted { font-size: 12px; color: var(--hud-muted); -unity-font-style: normal; }
.perspective .header Button { height: 40px; width: 102px; font-size: 16px; background-color: #304447; border-color: #304447; border-radius: 3px; }
.perspective .operations { height: 72px; background-color: #29343b; border-bottom-color: #52636e; padding: 7px 14px; }
.perspective .objective { width: 224px; padding-right: 14px; }
.perspective .objective .gold { font-size: 12px; color: #efd285; height: 15px; }
.perspective .objective .muted { font-size: 12px; height: 15px; color: #d9e3e1; }
.perspective .objective-label { font-size: 16px; height: 20px; }
.perspective .objective-track { height: 3px; margin-top: 4px; background-color: #17292c; }
.perspective .objective-fill { height: 3px; background-color: var(--hud-gold); }
.perspective .metric { min-width: 104px; height: 58px; margin-right: 12px; padding: 0 10px; border-width: 0; border-radius: 0; background-color: transparent; }
.perspective .metric.bottleneck .metric-value { color: #efd285; }
.perspective .metric .muted { font-size: 13px; height: 16px; color: #d9e3e1; }
.perspective .metric-value { font-size: 24px; height: 27px; -unity-font-style: bold; white-space: nowrap; }
.perspective .metric .metric-detail { font-size: 12px; height: 15px; color: #d9e3e1; -unity-font-style: normal; }
.perspective .recommendation { width: 238px; padding-left: 12px; border-left-width: 0; }
.perspective .recommendation-label { font-size: 15px; color: #eef4ee; margin-right: 10px; min-width: 0; flex-shrink: 1; }
.perspective .recommendation Button { width: 80px; height: 44px; font-size: 14px; }
.perspective .dock { height: 100px; padding: 5px 14px; background-color: #e9eff2; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: #b8c7cf; }
.perspective .dock-sector { width: 98px; }
.perspective .dock-sector .gold { color: var(--hud-ink); font-size: 15px; }
.perspective .dock-sector .muted { color: var(--hud-muted); font-size: 13px; }
.perspective .dock-inner { height: 95px; }
.perspective .dock-actions { height: 95px; align-items: flex-start; }
.perspective .dock-action { width: 25%; height: 95px; min-width: 0; margin-right: 16px; }
.perspective .dock-action Button { height: 34px; min-height: 34px; max-height: 34px; min-width: 0; flex-shrink: 0; padding-top: 2px; padding-bottom: 2px; font-size: 16px; border-radius: 3px; }
.perspective .dock-detail { font-size: 13px; height: 18px; flex-shrink: 0; color: var(--hud-muted); white-space: nowrap; }
.perspective .cargo-detail { font-size: 14px; height: 19px; flex-shrink: 0; color: var(--hud-ink); }
.perspective .pipeline-track { height: 3px; flex-shrink: 0; margin: 3px 2px 0 2px; background-color: #bccdc4; }
.perspective .pipeline-fill { height: 3px; background-color: #23846a; }
.perspective .dock-action .compiler-machine { height: 22px; flex-shrink: 0; margin: 0 2px; background-color: #263d3e; border-width: 0; border-radius: 0; }
.perspective .dock-action .compiler-wheel { top: 2px; width: 16px; height: 16px; }
.perspective .dock-action .machine-title { display: none; }
.perspective .dock-action .compute-bar { width: 10px; }
.perspective .dock-action .compiler-options { height: 22px; min-height: 22px; max-height: 22px; padding: 0 6px; margin: 0 2px; font-size: 13px; white-space: nowrap; background-color: transparent; color: var(--hud-ink); border-width: 0; }
.perspective .compiler-output { font-size: 22px; }
.perspective .underground { width: 100%; align-self: stretch; }
.perspective .floors { right: 0; width: 260px; background-color: var(--hud-paper); }
.perspective .room { height: 108px; padding: 6px 12px 20px 58px; background-color: transparent; border-width: 0; border-radius: 0; }
.perspective .manager-area { top: 30px; }
.perspective .manager-area .muted { display: none; }
.perspective .manager-area .portrait { height: 34px; flex-shrink: 0; border-radius: 0; border-width: 0; background-color: transparent; }
.perspective .manager-area .bin { width: 46px; height: 28px; flex-shrink: 0; color: #73521c; font-size: 12px; white-space: normal; -unity-text-align: middle-center; }
.perspective .room-main { min-height: 52px; }
.perspective .room-title { left: -52px; height: 24px; font-size: 19px; color: var(--hud-ink); white-space: nowrap; }
.perspective .room-rate { top: 28px; width: 96px; height: 24px; font-size: 13px; color: #17634e; white-space: normal; }
.perspective .generate { width: 84px; height: 28px; font-size: 13px; bottom: 0; background-color: var(--hud-teal); }
.perspective .floor-options { width: 88px; min-width: 88px; max-width: 88px; height: 30px; flex-shrink: 0; font-size: 12px; }
.perspective .options-area { height: 30px; min-height: 30px; max-height: 30px; }
.perspective .options-area Label { width: 44px; min-width: 44px; max-width: 44px; height: 30px; margin: 0; flex-shrink: 0; font-size: 12px; color: var(--hud-muted); -unity-text-align: middle-left; }
.perspective .options-area .muted { width: 38px; min-width: 38px; max-width: 38px; white-space: nowrap; }
.perspective .floor-milestone { color: var(--hud-muted); font-size: 11px; }
.perspective .floor-milestone-track { background-color: #d3ddd5; }
.perspective .floor-milestone-fill { background-color: #34867d; }
.perspective .construction { height: 124px; padding: 14px; background-color: transparent; border-width: 0; border-radius: 0; }
.perspective .construction-title { color: var(--hud-ink); font-size: 19px; }
.perspective .construction Button { background-color: var(--hud-gold); border-color: #c19c43; }
.perspective .navigation { background-color: #eef3f5; border-radius: 0; border-width: 0; }
.perspective .shaft-controls Button { background-color: #30494b; border-color: #617977; border-radius: 4px; }
.perspective .dialog { width: 540px; background-color: var(--hud-paper); color: var(--hud-ink); border-color: var(--hud-line); border-top-color: var(--hud-teal); border-radius: 4px; }
.perspective .dialog .unity-scroll-view__content-container { width: 100%; min-width: 0; padding-right: 12px; }
.perspective .dialog-title { color: var(--hud-ink); font-size: 22px; -unity-font-style: bold; }
.perspective .dialog .muted { color: var(--hud-muted); }
.perspective .quest-question { color: var(--hud-ink); font-size: 18px; white-space: normal; margin: 8px 0; flex-shrink: 0; }
.perspective .quest-reward { color: #176648; font-size: 16px; margin-bottom: 8px; white-space: normal; flex-shrink: 0; }
.perspective .quest-answers { flex-direction: row; flex-shrink: 0; }
.perspective .quest-answer { flex-grow: 1; flex-basis: 0; min-width: 0; height: 44px; margin: 2px 4px 2px 0; font-size: 18px; }
.perspective .quest-feedback { color: var(--hud-ink); font-size: 17px; white-space: normal; margin-top: 10px; flex-shrink: 0; }
.perspective .quest-hint { border-left-width: 3px; border-left-color: #bc8a25; padding: 8px 10px; background-color: #fbf0d5; }
.perspective .quest-solution { border-left-width: 3px; border-left-color: #147d80; padding: 8px 10px; background-color: #dfeeed; }
.perspective .quest-illustration { flex-direction: row; margin: 8px 0; flex-shrink: 0; }
.perspective .quest-diagram-cell { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 8px 2px; margin-right: 3px; background-color: #e1e8eb; color: #293238; border-bottom-width: 3px; border-bottom-color: #147d80; font-size: 13px; -unity-text-align: middle-center; white-space: normal; }
.perspective .quest-diagram-limit { background-color: #fbf0d5; border-bottom-color: #bc8a25; }
.perspective .company-ledger { margin: 4px 0 12px 0; }
.perspective .ledger-row { height: 28px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: #d5ded7; }
.perspective .ledger-title { font-size: 16px; color: var(--hud-muted); flex-grow: 1; }
.perspective .ledger-value { font-size: 17px; color: var(--hud-ink); -unity-font-style: bold; }
.perspective .company-summary { font-size: 15px; color: #196d57; margin-bottom: 8px; }
.perspective .contract-command { background-color: #366579; border-color: #6c9199; }
.perspective .contract-action .cargo-detail { font-size: 13px; white-space: nowrap; }
.perspective .contract-active { color: #196d57; font-size: 14px; margin-bottom: 6px; -unity-font-style: bold; }
.perspective .contract-offer { padding: 12px 0; border-top-width: 1px; border-top-color: var(--hud-line); flex-shrink: 0; }
.perspective .contract-heading { flex-direction: row; align-items: center; margin-bottom: 2px; }
.perspective .company-swatch { width: 8px; height: 16px; margin-right: 8px; flex-shrink: 0; }
