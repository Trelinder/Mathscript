.perspective.compact-screen .dock { height: 100px; padding: 3px 10px; }
.perspective.compact-screen .dock-sector { display: none; }
.perspective.compact-screen .dock-inner, .perspective.compact-screen .dock-actions { height: 94px; }
.perspective.compact-screen .dock-action { width: 25%; height: 94px; margin-right: 4px; }
.perspective.compact-screen .dock-action Button { height: 76px; min-height: 76px; max-height: 76px; font-size: 26px; padding: 2px; margin: 0 2px; }
.perspective.compact-screen .dock-detail { height: 18px; font-size: 18px; margin: 0; }
.perspective.compact-screen .cargo-detail, .perspective.compact-screen .pipeline-track, .perspective.compact-screen .compiler-machine { display: none; }
.perspective.compact-screen .shaft-controls { height: 160px; }
.perspective.compact-screen .shaft-controls Button { height: 76px; min-height: 76px; font-size: 20px; white-space: normal; }
.perspective.compact-screen .floors { top: 0; bottom: 0; }
.perspective.compact-screen .room, .perspective.compact-screen .construction { height: 156px; }
.perspective.compact-screen .manager-area { display: none; }
.perspective.compact-screen .room { padding: 6px 10px; }
.perspective.compact-screen .room-title { left: 0; height: 30px; font-size: 22px; }
.perspective.compact-screen .room-rate { top: 31px; width: 230px; font-size: 20px; }
.perspective.compact-screen .room-main { min-height: 140px; }
.perspective.compact-screen .generate { left: 0; bottom: 0; width: 112px; height: 76px; font-size: 21px; }
.perspective.compact-screen .options-area { position: absolute; right: 8px; bottom: 8px; width: 126px; height: 76px; min-height: 76px; max-height: 76px; }
.perspective.compact-screen .options-area Label { display: none; }
.perspective.compact-screen .options-area .muted { display: none; }
.perspective.compact-screen .floor-options { width: 122px; min-width: 122px; max-width: 122px; height: 76px; font-size: 21px; }
.perspective.compact-screen .floor-milestone, .perspective.compact-screen .floor-milestone-track { display: none; }
.perspective.compact-screen .construction-title { font-size: 22px; height: 40px; white-space: normal; }
.perspective.compact-screen .construction Button { height: 76px; font-size: 21px; }
.perspective.compact-screen .dialog { width: 740px; max-height: 96%; font-size: 23px; }
.perspective.compact-screen .dialog Button { height: 76px; min-height: 76px; font-size: 23px; }
.perspective.compact-screen .dialog-title { font-size: 28px; }
.perspective.compact-screen .dialog .muted { font-size: 21px; }